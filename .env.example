# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit your real ".env" file - it contains a secret token.

# Azure DevOps Personal Access Token (Settings > Personal Access Tokens in Azure DevOps).
# Needs read access to Test Plans and Work Items.
AZDO_PAT=your-personal-access-token-here

# Your Azure DevOps organization name (the part right after dev.azure.com/ in your URL).
AZDO_ORG=your-organization-name

# Your Azure DevOps project name. A SINGLE project name only, not a
# comma-separated list (the ScopeBar's project dropdown is what lets users
# work across multiple projects - this is just the fallback default used
# when a request doesn't specify one).
AZDO_PROJECT=your-project-name

# There is no sign-in wall - anyone who can reach this server can read
# dashboard data. Access is effectively gated by AZDO_PAT above: if it's
# valid, data loads; if not, the API returns 502s and the dashboard renders
# an empty screen. Put this behind a VPN/firewall/reverse-proxy auth layer
# if that's not restrictive enough for your deployment.

# Comma-separated list of origins allowed to call this API (CORS).
# Include your GitHub Pages URL in production, e.g.:
# https://your-org.github.io
CORS_ORIGIN=http://localhost:3000



# Comma-separated list of email addresses to receive emailed reports
# triggered from the dashboard's export menu.
SEND_MAIL_TO=your-email@example.com

# Enables the "Email report" export option on the dashboard. Must also
# match VITE_ENABLE_EMAIL_REPORT in client/.env.
ENABLE_EMAIL_REPORT=false

# SMTP credentials used to send the emailed report (with the PDF attached).
# For Office 365 / Exchange Online: smtp.office365.com, port 587,
# SMTP_SECURE=false (STARTTLS), and the mailbox's password (or an app
# password if MFA is enabled on that mailbox).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@your-company.com
SMTP_PASS=your-password-or-app-password
MAIL_FROM=your-mailbox@your-company.com

# Optional: send via Microsoft Graph's sendMail instead of SMTP entirely.
# Use this when the tenant blocks SMTP outright - basic auth (error 535
# 5.7.139, Conditional Access blocking legacy auth) and/or OAuth2-over-SMTP
# (the "SMTP.SendAsApp" permission is often refused by governance, since
# Microsoft is deprecating SMTP AUTH tenant-wide). Graph's sendMail is a
# plain HTTPS call, not a legacy protocol, so it isn't caught by either.
# Requires an Entra ID app registration with the "Mail.Send" APPLICATION
# permission (API: Microsoft Graph) and admin consent - see mailer.ts.
# When all three are set, mail is sent via Graph and SMTP_PASS is unused.
MAIL_OAUTH_TENANT_ID=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=

# Enables the /api/release-readiness endpoint (release exit-criteria gate,
# sprint completion & carry-over, sprint-over-sprint pass rate delta,
# blocking defects at release). Must also match VITE_ENABLE_RELEASE_READINESS
# in client/.env.
ENABLE_RELEASE_READINESS=false

# Restricts the UI to only /defects and /release-readiness (every other
# route redirects to /defects, and the nav bar only shows those tabs). This
# is a client-only (UI navigation) restriction - it does not disable any
# API endpoints. Must also match VITE_SHOW_ONLY_DEFECT_AND_RELEASE in
# client/.env.
SHOW_ONLY_DEFECT_AND_RELEASE=false

# Release gate targets (optional - defaults shown below match the org's
# formal exit-criteria doc, code_coverage.md). RAG is Red if any BLOCK
# criterion fails, Amber if only a WARN criterion (Medium/Low severity
# defects open) fails, Green otherwise.
RELEASE_GATE_TESTS_EXECUTED_TARGET_PCT=100
RELEASE_GATE_TESTS_PASSED_TARGET_PCT=95
RELEASE_GATE_REQUIREMENTS_COVERAGE_TARGET_PCT=95

# Enables the Teams "bugs reported today" daily summary.
ENABLE_TEAMS_NOTIFICATIONS=false

# Incoming Webhook URL for the Teams channel (Channel > ... > Connectors >
# Incoming Webhook). Required when ENABLE_TEAMS_NOTIFICATIONS=true.
TEAMS_WEBHOOK_URL=

# Optional: Incoming Webhook URL for a separate test/staging Teams channel.
# Only used by `npm run test:teams`, which sends sample cards straight to
# this URL (bypassing ENABLE_TEAMS_NOTIFICATIONS) so you can check how a card
# renders in Teams without touching the real channel or waiting for a cron
# tick.
TEAMS_WEBHOOK_URL_TEST_CHANNEL=

# Incoming Webhook URL the "Bug pronti per essere verificati" notification
# (see ENABLE_TEAMS_VERIFICA_NOTIFICATIONS below) posts to - a different
# channel than TEAMS_WEBHOOK_URL, so it doesn't mix into the daily digest.
# Falls back to TEAMS_WEBHOOK_URL when unset.
TEAMS_WEBHOOK_URL_TEST_FACTORY=

# Cron expression (node-cron syntax) for the "bugs reported today" report.
# Default: 17:45, Monday-Friday. Sends nothing on days with zero new bugs.
TEAMS_DAILY_SUMMARY_CRON=45 17 * * 1-5

# IANA timezone the cron expression above is evaluated in.
TEAMS_SUMMARY_TIMEZONE=Europe/Rome

# Name used in the "Hey <name>, N bug(s) were created today" greeting.
TEAMS_GREETING_NAME=team

# Enables a second, separate Teams notification: a short message posted
# whenever a bug is moved to "Da verificare", but only when its assignee has
# an allowed email (see TEAMS_VERIFICA_ALLOWED_SENDERS below). Requires
# ENABLE_TEAMS_NOTIFICATIONS=true too - this flag only toggles this specific
# card on top of that. Posts to TEAMS_WEBHOOK_URL_TEST_FACTORY above.
ENABLE_TEAMS_VERIFICA_NOTIFICATIONS=false

# Optional: Azure DevOps project to check for "Da verificare" bugs, if it's
# different from AZDO_PROJECT (the app's general-purpose default). Falls
# back to AZDO_PROJECT when unset.
TEAMS_VERIFICA_PROJECT=

# Comma-separated allowlist of assignees whose bugs trigger the "sent to
# verifica" message. Each entry is either a bare domain (matches any address
# @that domain) or a full email address (matched exactly). Default: anyone
# @finconsgroup.com.
TEAMS_VERIFICA_ALLOWED_SENDERS=finconsgroup.com

# Cron expression (node-cron syntax) for how often to poll for bugs newly
# moved to "Da verificare". Default: every 10 minutes.
TEAMS_VERIFICA_CRON=*/10 * * * *

# IANA timezone the cron expression above is evaluated in.
TEAMS_VERIFICA_TIMEZONE=Europe/Rome

# Enables writing a daily copy of the Sprint Defect Report PDF to a local
# folder (e.g. a synced OneDrive/SharePoint folder, so it shows up in Teams).
ENABLE_SPRINT_REPORT_EXPORT=false

# Absolute folder path the daily PDF is written into. Required when
# ENABLE_SPRINT_REPORT_EXPORT=true.
SPRINT_REPORT_EXPORT_PATH=

# Cron expression (node-cron syntax) for the daily Sprint Defect Report file
# export. Default: 18:00 every day.
SPRINT_REPORT_EXPORT_CRON=0 18 * * *

# IANA timezone the cron expression above is evaluated in.
SPRINT_REPORT_EXPORT_TIMEZONE=Europe/Rome